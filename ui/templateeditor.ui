            </item>
            <item>
             <widget class="QPushButton" name="removeSubstitutionButton">
              <property name="text">
               <string>Удалить</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabTbCreation">
      <attribute name="title">
       <string>Создание ТБ</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_2">
       <item>
        <widget class="QCheckBox" name="generateTbCheckBox">
         <property name="toolTip">
          <string>Строит титры благодарности по данным шаблона и таймингу эндинга (глава или ручное время). При выключении этапы ТБ в рендере пропускаются.</string>
         </property>
